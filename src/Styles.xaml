<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:BlueAux;assembly=BlueAux">

  <!--
    BlueAux's design system: Fluent 2, the one Windows 11 itself uses, rebuilt here so the app stays a single file.
    - Colour: tokens from Theme.cs (Windows light/dark, OLED, Graphite, Paper, plus your accent colour),
      always used through DynamicResource so a theme switches live.
    - Type: Segoe UI Variable at its optical sizes (Small for captions, Text for body, Display for titles),
      falling back to Segoe UI on Windows 10. Caption 12/16, Body 14/20, Body Strong 14/20 semibold,
      Subtitle 20/28 semibold, Hero title 22/28 semibold.
    - Space: multiples of 4 (4, 8, 12, 16, 24).
    - Shape: 4 px corners on controls, 8 px on cards, 12 px on the now-playing card.
    - Motion: Fluent's 83 / 167 / 250 ms ramp from Motion (x:Static), 0 ms when animations are off.
    - Controls: Button, AccentButton, SubtleButton, IconButton, HyperlinkButton, Switch, NumberBox, ThemeSwatch,
      plus Card, AppearingCard, HeroCard, Divider and InfoBar for layout.
  -->

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <CornerRadius x:Key="ControlCorner">4</CornerRadius>
  <CornerRadius x:Key="CardCorner">8</CornerRadius>
  <CornerRadius x:Key="HeroCorner">12</CornerRadius>
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

  <!-- ============ Type ramp ============ -->

  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- Text styles fold away when they have nothing to say, so layouts don't keep empty lines. -->
  <Style x:Key="TextBase" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>

  <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>

  <Style x:Key="BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>

  <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="LineHeight" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- The song (or the phone) on the now-playing card: a size up from Subtitle, still fitting the window. -->
  <Style x:Key="HeroTitle" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
    <Setter Property="FontSize" Value="22"/>
  </Style>

  <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrong}">
    <Setter Property="Margin" Value="4,20,0,8"/>
  </Style>

  <!-- ============ Surfaces ============ -->

  <!-- A card: its fill and stroke, over a soft shadow that only the light themes switch on. -->
  <ControlTemplate x:Key="CardTemplate" TargetType="ContentControl">
    <Grid>
      <Border CornerRadius="{StaticResource CardCorner}" Background="Black" Margin="2,3,2,-3"
              Opacity="{DynamicResource CardShadowOpacity}" Visibility="{DynamicResource CardShadowVisibility}">
        <Border.Effect>
          <BlurEffect Radius="10"/>
        </Border.Effect>
      </Border>
      <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
              CornerRadius="{StaticResource CardCorner}" Padding="{TemplateBinding Padding}">
        <ContentPresenter/>
      </Border>
    </Grid>
  </ControlTemplate>

  <Style x:Key="Card" TargetType="ContentControl">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template" Value="{StaticResource CardTemplate}"/>
  </Style>

  <!-- A card that comes and goes (offers, warnings): it fades in and rises 8 px when it appears. -->
  <Style x:Key="AppearingCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid x:Name="Root">
            <Grid.RenderTransform>
              <TranslateTransform/>
            </Grid.RenderTransform>
            <Border CornerRadius="{StaticResource CardCorner}" Background="Black" Margin="2,3,2,-3"
                    Opacity="{DynamicResource CardShadowOpacity}" Visibility="{DynamicResource CardShadowVisibility}">
              <Border.Effect>
                <BlurEffect Radius="10"/>
              </Border.Effect>
            </Border>
            <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static b:Motion.Slow}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="8" To="0" Duration="{x:Static b:Motion.Slow}" EasingFunction="{StaticResource EaseOut}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The now-playing card: bigger corners and a hairline that catches the light at the top. -->
  <Style x:Key="HeroCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border CornerRadius="{StaticResource HeroCorner}" Background="Black" Margin="2,4,2,-4"
                    Opacity="{DynamicResource CardShadowOpacity}" Visibility="{DynamicResource CardShadowVisibility}">
              <Border.Effect>
                <BlurEffect Radius="14"/>
              </Border.Effect>
            </Border>
            <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource HeroStroke}" BorderThickness="1"
                    CornerRadius="{StaticResource HeroCorner}" Padding="{TemplateBinding Padding}" ClipToBounds="True">
              <ContentPresenter/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource DividerStroke}"/>
  </Style>

  <Style x:Key="InfoBar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CautionSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource ControlCorner}"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>

  <!-- Two-tone focus ring (WinUI): a strong outer line with a contrasting inner one. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource FocusOuter}">
            <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource FocusInner}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Buttons ============ -->

  <!-- Pointing at a button fades its hover fill in; pressing shrinks it a touch (Fluent's 83 / 167 ms). -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Storyboard x:Key="PressIn">
    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="{x:Static b:Motion.Fast}"/>
    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="{x:Static b:Motion.Fast}"/>
    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static b:Motion.Fast}"/>
  </Storyboard>
  <Storyboard x:Key="PressOut">
    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static b:Motion.Normal}"/>
  </Storyboard>
  <Storyboard x:Key="HoverIn">
    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static b:Motion.Fast}"/>
  </Storyboard>
  <Storyboard x:Key="HoverOut">
    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static b:Motion.Normal}"/>
  </Storyboard>

  <!-- Fluent "standard" button -->
  <Style x:Key="Button" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform/>
            </Grid.RenderTransform>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource ControlCorner}"/>
            <Border x:Name="Hover" Background="{DynamicResource ControlFillHover}" CornerRadius="{StaticResource ControlCorner}" Margin="1" Opacity="0"/>
            <Border x:Name="Press" Background="{DynamicResource ControlFillPressed}" CornerRadius="{StaticResource ControlCorner}" Margin="1" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource PressIn}"/>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource PressOut}"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The accent button dims to 90 % on hover and 80 % when pressed, as Fluent's AccentFillColor shades do. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform/>
            </Grid.RenderTransform>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCorner}"/>
            <Border x:Name="Hover" Background="{DynamicResource WindowBackground}" CornerRadius="{StaticResource ControlCorner}" Opacity="0"/>
            <Border x:Name="Press" Background="{DynamicResource WindowBackground}" CornerRadius="{StaticResource ControlCorner}" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.1" Duration="{x:Static b:Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="{x:Static b:Motion.Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="{x:Static b:Motion.Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.1" Duration="{x:Static b:Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource PressOut}"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- No fill until you point at it -->
  <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="{TemplateBinding Background}">
            <Grid.RenderTransform>
              <ScaleTransform/>
            </Grid.RenderTransform>
            <Border x:Name="Hover" Background="{DynamicResource SubtleHover}" CornerRadius="{StaticResource ControlCorner}" Opacity="0"/>
            <Border x:Name="Press" Background="{DynamicResource SubtlePressed}" CornerRadius="{StaticResource ControlCorner}" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource HoverIn}"/>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HoverOut}"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource PressIn}"/>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource PressOut}"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style x:Key="HyperlinkButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <!-- A theme in Settings: a little window with a card in it, framed in the accent colour when chosen. -->
  <Style x:Key="ThemeSwatch" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <StackPanel Background="Transparent" Margin="0,12,0,8">
            <Border x:Name="Frame" Width="60" Height="44" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource ControlStroke}"
                    Background="{Binding Window}" Padding="8,9,8,0">
              <Border CornerRadius="4,4,0,0" Background="{Binding Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1,1,1,0" Padding="6,6,6,0">
                <StackPanel>
                  <Rectangle Height="3" Width="18" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Ink}" HorizontalAlignment="Left"/>
                  <Rectangle Height="3" Width="11" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Ink}" Opacity="0.45" HorizontalAlignment="Left" Margin="0,3,0,0"/>
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Border>
            <TextBlock x:Name="Label" Style="{StaticResource Caption}" Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextTertiary}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The title bar's own buttons: Windows 11's size and glyphs, in the theme's colours. "Tag" carries the
       hover and pressed state for the maximize button, which Windows drives itself (so its snap layouts
       flyout works) rather than the mouse events the other two get. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="Hover" Background="{DynamicResource SubtleHover}" Opacity="0"/>
            <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="Tag" Value="hover">
              <Setter TargetName="Hover" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="Tag" Value="pressed">
              <Setter TargetName="Hover" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="Hover" Background="#C42B1C" Opacity="0"/>
            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="10" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1"/>
              <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Inputs ============ -->

  <!-- A Fluent toggle switch. Content sits on the left, the switch on the right. The knob slides across,
       and stretches while you hold it, as WinUI's does. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RowIcon" Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0"/>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Grid Grid.Column="2" Width="40" Height="20" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource TextSecondary}" Background="{DynamicResource ControlFill}"/>
              <Border x:Name="On" CornerRadius="10" Background="{DynamicResource Accent}" Opacity="0"/>
              <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                       Fill="{DynamicResource TextSecondary}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform/>
                    <TranslateTransform/>
                  </TransformGroup>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
              <Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                     To="20" Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static b:Motion.Normal}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                     To="0" Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static b:Motion.Normal}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.17" Duration="{x:Static b:Motion.Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.17" Duration="{x:Static b:Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{x:Static b:Motion.Normal}"/>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="{x:Static b:Motion.Normal}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.45" Duration="{x:Static b:Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.17" Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A switch as a whole settings row -->
  <Style x:Key="SettingSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
    <Setter Property="MinHeight" Value="48"/>
  </Style>

  <Style x:Key="NumberBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCorner}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Margin="1,0" Background="{DynamicResource Accent}" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFocused}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static b:Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Underline" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static b:Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Overlays ============ -->

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource Tooltip}"/>
    <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MaxWidth" Value="280"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1"
                  CornerRadius="{StaticResource ControlCorner}" Padding="9,6,9,7" Opacity="0">
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap"/>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static b:Motion.Normal}"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin, quiet scrollbar -->
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBar" Width="4" CornerRadius="2" Background="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBar" Property="Width" Value="6"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
