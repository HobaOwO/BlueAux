<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>

    <!-- A phone on the main page (only shown when you have more than one) -->
    <DataTemplate x:Key="DeviceRow">
      <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid Width="36" Height="36" VerticalAlignment="Center">
            <Ellipse x:Name="Badge" Fill="{DynamicResource Subtle}"/>
            <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16"/>
          </Grid>

          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Button Style="{StaticResource SubtleButton}" Content="Connect" Command="{Binding ConnectCommand}"
                    Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource SubtleButton}" Content="Connecting…" IsEnabled="False"
                    Visibility="{Binding ShowConnecting, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource SubtleButton}" Content="Disconnect" Command="{Binding DisconnectCommand}"
                    Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StateName}" Value="Streaming">
          <Setter TargetName="Badge" Property="Fill" Value="{DynamicResource Accent}"/>
          <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A phone in Settings: auto-connect and hide -->
    <DataTemplate x:Key="DeviceSettingsRow">
      <Border x:Name="Row" Style="{StaticResource Card}" Margin="0,0,0,4" Padding="16,12">
        <StackPanel>
          <CheckBox x:Name="Auto" Style="{StaticResource Switch}" IsChecked="{Binding AutoConnect}"
                    AutomationProperties.Name="{Binding DisplayName}">
            <StackPanel>
              <TextBlock Text="{Binding DisplayName}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
              <TextBlock Style="{StaticResource Secondary}" Text="{Binding SettingsHint}"/>
            </StackPanel>
          </CheckBox>
          <Button Style="{StaticResource LinkButton}" Content="{Binding HideText}" Command="{Binding HideCommand}"
                  HorizontalAlignment="Left" Margin="-8,4,0,-4" FontSize="12"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Auto" Property="IsEnabled" Value="False"/>
          <Setter TargetName="Row" Property="Opacity" Value="0.7"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="16,13"/>
    </Style>

  </Grid.Resources>

  <!-- ===================== Main page ===================== -->
  <Grid Visibility="{Binding IsMainOpen, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="20,6,20,20">

        <Grid>
          <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,-8,0"
                  Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
          </Button>
        </Grid>

        <!-- Status -->
        <Grid Height="168" Margin="0,4,0,0">
          <Ellipse x:Name="Ring1" Width="116" Height="116" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="Ring2" Width="116" Height="116" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="HeroCircle" Width="116" Height="116" Fill="{DynamicResource Accent}"/>
          <TextBlock x:Name="HeroGlyph" Style="{StaticResource Icon}" FontSize="46" Text="{Binding HeroGlyph}"/>
          <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Rectangle x:Name="Bar0" Width="7" Height="42" RadiusX="3.5" RadiusY="3.5" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar1" Width="7" Height="42" RadiusX="3.5" RadiusY="3.5" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar2" Width="7" Height="42" RadiusX="3.5" RadiusY="3.5" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar3" Width="7" Height="42" RadiusX="3.5" RadiusY="3.5" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar4" Width="7" Height="42" RadiusX="3.5" RadiusY="3.5" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
            </Rectangle>
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding HeroTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding HeroSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Margin="0,6,0,0" LineHeight="19"/>

        <!-- The PC itself is muted: the most common "no sound" of all -->
        <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource CautionSoft}" HorizontalAlignment="Center"
                Visibility="{Binding ShowPcSilenced, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74F;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Caution}"/>
            <TextBlock Text="This PC's sound is muted or turned all the way down." FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- One button that does the obvious next thing -->
        <Grid HorizontalAlignment="Center" Margin="0,18,0,0">
          <Button Style="{StaticResource AccentButton}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}"
                  Padding="28,8" MinWidth="150"
                  Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}"/>
          <Button Style="{StaticResource SubtleButton}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}"
                  Padding="28,8" MinWidth="150"
                  Visibility="{Binding ShowSecondaryAction, Converter={StaticResource BoolToVis}}"/>
        </Grid>
        <Button Style="{StaticResource LinkButton}" Command="{Binding FixAudioCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"
                Visibility="{Binding ShowFixAudio, Converter={StaticResource BoolToVis}}"
                ToolTip="Press play on your phone first, then click this. Reconnecting while music plays gets stuck sound going again.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="12" Margin="0,0,6,0"/>
            <TextBlock Text="No sound? Press play on your phone, then click here"/>
          </StackPanel>
        </Button>

        <!-- First run: offer to start with Windows -->
        <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="16,14"
                Visibility="{Binding ShowStartupPrompt, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="18" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Top" Margin="0,2,14,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Start with Windows?" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,4,0,12" LineHeight="18"
                         Text="Then it waits quietly in the tray and your phone connects whenever it's nearby, like in a car."/>
              <WrapPanel>
                <Button Style="{StaticResource AccentButton}" Content="Yes, start with Windows" Command="{Binding EnableStartupCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SubtleButton}" Content="Not now" Command="{Binding DismissStartupCommand}"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Several phones: pick which one plays -->
        <StackPanel Visibility="{Binding ShowDeviceList, Converter={StaticResource BoolToVis}}">
          <TextBlock Style="{StaticResource SectionHeader}" Text="Other devices" Margin="2,26,0,8"/>
          <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False"/>
        </StackPanel>

        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding PairCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"/>
            <TextBlock Text="Add a phone"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- ===================== Settings page ===================== -->
  <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="20,6,20,20">

        <StackPanel Orientation="Horizontal" Margin="-8,0,0,4">
          <Button Style="{StaticResource IconButton}" Command="{Binding CloseSettingsCommand}" ToolTip="Back" AutomationProperties.Name="Back">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;"/>
          </Button>
          <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,2"/>
        </StackPanel>

        <Border Style="{StaticResource SettingRow}" Margin="0,14,0,4">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}">
            <StackPanel>
              <TextBlock Text="Start with Windows" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="Waits in the tray so your phone can connect any time"/>
            </StackPanel>
          </CheckBox>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Notifications}">
            <StackPanel>
              <TextBlock Text="Notifications" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="Tell me when a phone connects or disconnects"/>
            </StackPanel>
          </CheckBox>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <StackPanel>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RestWhenIdle}">
              <StackPanel>
                <TextBlock Text="Rest when I'm away" FontSize="13.5"/>
                <TextBlock Style="{StaticResource Secondary}"
                           Text="With no mouse or keyboard use (or the PC locked), stop looking for your phone. Music that's playing keeps going."/>
              </StackPanel>
            </CheckBox>
            <StackPanel Margin="0,14,0,0" Visibility="{Binding RestWhenIdle, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="After" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding IdleLessCommand}" Padding="0" Width="32" MinHeight="32"
                        ToolTip="Less" AutomationProperties.Name="Fewer minutes">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12"/>
                </Button>
                <TextBox x:Name="IdleBox" Style="{StaticResource NameBox}" Text="{Binding IdleMinutesText}" Width="56" MaxLength="3"
                         TextAlignment="Center" Margin="6,0" AutomationProperties.Name="Idle minutes"/>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding IdleMoreCommand}" Padding="0" Width="32" MinHeight="32"
                        ToolTip="More" AutomationProperties.Name="More minutes">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                </Button>
                <TextBlock Text="minutes" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisconnectWhenIdle}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Disconnect the phone too" FontSize="13"/>
                  <TextBlock Style="{StaticResource Secondary}"
                             Text="Off is more reliable: some iPhones come back without sound after being disconnected while paused."/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Your devices"/>
        <ItemsControl ItemsSource="{Binding AllDevices}" ItemTemplate="{StaticResource DeviceSettingsRow}" Focusable="False"/>

        <Button Style="{StaticResource LinkButton}" Command="{Binding ToggleMoreCommand}" HorizontalAlignment="Left" Margin="-8,16,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="More options" FontSize="13"/>
            <TextBlock FontSize="10" Margin="8,2,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                  <Setter Property="Text" Value="&#xE70D;"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMoreOpen}" Value="True">
                      <Setter Property="Text" Value="&#xE70E;"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>

        <StackPanel Visibility="{Binding IsMoreOpen, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}">
              <StackPanel>
                <TextBlock Text="Keep running when closed" FontSize="13.5"/>
                <TextBlock Style="{StaticResource Secondary}" Text="Closing the window hides it to the tray instead of quitting"/>
              </StackPanel>
            </CheckBox>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepAwake}">
              <StackPanel>
                <TextBlock Text="Keep the PC awake while playing" FontSize="13.5"/>
                <TextBlock Style="{StaticResource Secondary}" Text="Stops the PC from going to sleep in the middle of a song"/>
              </StackPanel>
            </CheckBox>
          </Border>

          <WrapPanel Margin="0,10,0,0">
            <Button Style="{StaticResource SubtleButton}" Command="{Binding PairCommand}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE702;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Bluetooth settings"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButton}" Command="{Binding SoundSettingsCommand}" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Sound settings"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButton}" Command="{Binding RestartCommand}" Margin="0,0,8,8"
                    ToolTip="Drops and rebuilds every connection. Use it if something seems stuck.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Restart connections"/>
              </StackPanel>
            </Button>
          </WrapPanel>

          <Grid Margin="0,10,0,8">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Recent activity" Margin="2,0,0,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Content="Open log folder" Command="{Binding OpenLogCommand}"/>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="14,10">
            <ItemsControl ItemsSource="{Binding LogEntries}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- About -->
        <StackPanel Margin="2,22,2,0">
          <TextBlock Text="{Binding AboutText}" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
          <WrapPanel Margin="-8,2,0,0">
            <Button Style="{StaticResource LinkButton}" Content="Open on GitHub" Command="{Binding OpenRepoCommand}" FontSize="12"/>
            <Button Style="{StaticResource LinkButton}" Content="Report a problem" Command="{Binding ReportProblemCommand}" FontSize="12"/>
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Grid>
