<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>

    <DataTemplate x:Key="DeviceCard">
      <Border x:Name="CardBorder" Style="{StaticResource Card}" Margin="0,0,0,6">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Center">
              <Ellipse x:Name="Badge" Fill="{DynamicResource Subtle}"/>
              <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18"/>
              <Ellipse x:Name="Dot" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                       Fill="Transparent" StrokeThickness="0"/>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
              <Button Style="{StaticResource AccentButton}" Content="Connect" Command="{Binding ConnectCommand}"
                      Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}"/>
              <Button Style="{StaticResource SubtleButton}" Content="Connecting…" IsEnabled="False"
                      Visibility="{Binding ShowConnecting, Converter={StaticResource BoolToVis}}"/>
              <Button Style="{StaticResource SubtleButton}" Content="Disconnect" Command="{Binding DisconnectCommand}"
                      Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="4,0,-6,0" Command="{Binding ExpandCommand}" ToolTip="Options"
                    AutomationProperties.Name="Options">
              <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12"/>
            </Button>
          </Grid>

          <StackPanel Margin="52,14,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoConnect}">
              <StackPanel>
                <TextBlock Text="Connect automatically" FontSize="13"/>
                <TextBlock Style="{StaticResource Secondary}" Text="Reconnect by itself whenever this device is nearby"/>
              </StackPanel>
            </CheckBox>

            <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,4"/>
            <TextBox Style="{StaticResource NameBox}" Text="{Binding EditableName, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding AddressText}" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>

            <WrapPanel Margin="0,12,0,0">
              <Button Style="{StaticResource SubtleButton}" Command="{Binding FixCommand}" Margin="0,0,8,0"
                      ToolTip="Connected but no sound? This rebuilds the connection from scratch.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="14" Margin="0,0,8,0"/>
                  <TextBlock Text="Fix audio"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SubtleButton}" Command="{Binding HideCommand}"
                      ToolTip="Hidden devices never connect. Show them again from Settings.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="{Binding HideGlyph}" FontSize="14" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding HideText}"/>
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StateName}" Value="Streaming">
          <Setter TargetName="Badge" Property="Fill" Value="{DynamicResource Accent}"/>
          <Setter TargetName="BadgeGlyph" Property="Foreground" Value="{DynamicResource OnAccent}"/>
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}"/>
          <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource CardSolid}"/>
          <Setter TargetName="Dot" Property="StrokeThickness" Value="2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateName}" Value="Connecting">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Caution}"/>
          <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource CardSolid}"/>
          <Setter TargetName="Dot" Property="StrokeThickness" Value="2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="CardBorder" Property="Opacity" Value="0.6"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="16,13"/>
    </Style>

  </Grid.Resources>

  <!-- ===================== Main page ===================== -->
  <Grid Visibility="{Binding IsMainOpen, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="20,6,20,20">

        <Grid>
          <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,-8,0"
                  Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
          </Button>
        </Grid>

        <!-- Status hero -->
        <Grid Height="150" Margin="0,0,0,0">
          <Ellipse x:Name="Ring1" Width="104" Height="104" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="Ring2" Width="104" Height="104" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="HeroCircle" Width="104" Height="104" Fill="{DynamicResource Accent}"/>
          <TextBlock x:Name="HeroGlyph" Style="{StaticResource Icon}" FontSize="42" Text="{Binding HeroGlyph}"/>
          <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Rectangle x:Name="Bar0" Width="6" Height="38" RadiusX="3" RadiusY="3" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar1" Width="6" Height="38" RadiusX="3" RadiusY="3" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar2" Width="6" Height="38" RadiusX="3" RadiusY="3" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar3" Width="6" Height="38" RadiusX="3" RadiusY="3" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="Bar4" Width="6" Height="38" RadiusX="3" RadiusY="3" Margin="3,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
            </Rectangle>
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding HeroTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding HeroSubtitle}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Margin="0,6,0,0" LineHeight="19"/>
        <Button Style="{StaticResource AccentButton}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}"
                HorizontalAlignment="Center" Margin="0,16,0,0" Padding="20,7"
                Visibility="{Binding HasHeroAction, Converter={StaticResource BoolToVis}}"/>
        <Button Style="{StaticResource LinkButton}" Command="{Binding FixAudioCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                Visibility="{Binding ShowFixAudio, Converter={StaticResource BoolToVis}}"
                ToolTip="Press play on your phone first. This reconnects it, which gets stuck sound going again.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="12" Margin="0,0,6,0"/>
            <TextBlock Text="No sound? Fix it"/>
          </StackPanel>
        </Button>

        <!-- First run: offer to start with Windows -->
        <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,14"
                Visibility="{Binding ShowStartupPrompt, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="18" Foreground="{DynamicResource Accent}"
                       VerticalAlignment="Top" Margin="0,2,14,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Start with Windows?" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Secondary}" FontSize="12.5" Margin="0,4,0,12" LineHeight="18"
                         Text="Phone Speaker waits quietly in the tray, so your phone can connect any time, like a car stereo."/>
              <WrapPanel>
                <Button Style="{StaticResource AccentButton}" Content="Start with Windows" Command="{Binding EnableStartupCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SubtleButton}" Content="Not now" Command="{Binding DismissStartupCommand}"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Devices -->
        <Grid Margin="0,24,0,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Your devices" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,0"/>
            <TextBlock Text="{Binding DeviceCountText}" FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="8,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Command="{Binding PairCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"/>
              <TextBlock Text="Pair a phone"/>
            </StackPanel>
          </Button>
        </Grid>

        <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceCard}" Focusable="False"/>

        <TextBlock Style="{StaticResource Secondary}" Foreground="{DynamicResource TextTertiary}" Margin="2,10,2,0" LineHeight="17"
                   Text="Closing this window keeps Phone Speaker running in the tray, so your phone can reconnect any time."/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- ===================== Settings page ===================== -->
  <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="20,6,20,20">

        <StackPanel Orientation="Horizontal" Margin="-8,0,0,4">
          <Button Style="{StaticResource IconButton}" Command="{Binding CloseSettingsCommand}" ToolTip="Back" AutomationProperties.Name="Back">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;"/>
          </Button>
          <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,2"/>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Behaviour" Margin="2,14,0,8"/>

        <Border Style="{StaticResource SettingRow}">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}">
            <StackPanel>
              <TextBlock Text="Start with Windows" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="Start quietly in the tray when you sign in"/>
            </StackPanel>
          </CheckBox>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}">
            <StackPanel>
              <TextBlock Text="Keep running when closed" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="Closing the window hides it to the tray instead of quitting"/>
            </StackPanel>
          </CheckBox>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepAwake}">
            <StackPanel>
              <TextBlock Text="Keep PC awake while playing" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="Stops the PC from going to sleep in the middle of a song"/>
            </StackPanel>
          </CheckBox>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <StackPanel>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RestWhenIdle}">
              <StackPanel>
                <TextBlock Text="Rest when the PC is idle" FontSize="13.5"/>
                <TextBlock Style="{StaticResource Secondary}"
                           Text="When nobody uses the mouse or keyboard (or the PC is locked), stop looking for your phone. Starts again as soon as you're back. Music that's playing keeps going."/>
              </StackPanel>
            </CheckBox>
            <StackPanel Margin="0,14,0,0" Visibility="{Binding RestWhenIdle, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Idle after" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding IdleLessCommand}" Padding="0" Width="32" MinHeight="32"
                        ToolTip="Less" AutomationProperties.Name="Fewer minutes">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12"/>
                </Button>
                <TextBox x:Name="IdleBox" Style="{StaticResource NameBox}" Text="{Binding IdleMinutesText}" Width="56" MaxLength="3"
                         TextAlignment="Center" Margin="6,0" AutomationProperties.Name="Idle minutes"/>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding IdleMoreCommand}" Padding="0" Width="32" MinHeight="32"
                        ToolTip="More" AutomationProperties.Name="More minutes">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                </Button>
                <TextBlock Text="minutes" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisconnectWhenIdle}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Disconnect the phone too" FontSize="13"/>
                  <TextBlock Style="{StaticResource Secondary}"
                             Text="Off: a phone that's already connected stays connected while resting; only the searching stops."/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Notifications}">
            <StackPanel>
              <TextBlock Text="Notifications" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="Tell me when a phone connects or disconnects"/>
            </StackPanel>
          </CheckBox>
        </Border>
        <Border Style="{StaticResource SettingRow}">
          <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowHidden}">
            <StackPanel>
              <TextBlock Text="Show hidden devices" FontSize="13.5"/>
              <TextBlock Style="{StaticResource Secondary}" Text="List devices you've hidden so you can bring them back"/>
            </StackPanel>
          </CheckBox>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Bluetooth &amp; sound"/>
        <WrapPanel>
          <Button Style="{StaticResource SubtleButton}" Command="{Binding PairCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE702;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Bluetooth settings"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SubtleButton}" Command="{Binding SoundSettingsCommand}" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Sound output"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SubtleButton}" Command="{Binding RestartCommand}" Margin="0,0,8,8"
                  ToolTip="Drops and rebuilds every connection. Use it if something seems stuck.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0"/>
              <TextBlock Text="Restart connections"/>
            </StackPanel>
          </Button>
        </WrapPanel>

        <Grid Margin="0,14,0,8">
          <TextBlock Style="{StaticResource SectionHeader}" Text="Recent activity" Margin="2,0,0,0" VerticalAlignment="Center"/>
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Content="Open full log" Command="{Binding OpenLogCommand}"/>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="14,10">
          <ItemsControl ItemsSource="{Binding LogEntries}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Style="{StaticResource Secondary}" Foreground="{DynamicResource TextTertiary}" Margin="2,18,2,0" LineHeight="17"
                   Text="Phone Speaker 1.0 · uses the Bluetooth audio receiver built into Windows. Loudness follows both your phone's volume and this PC's volume."/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Grid>
