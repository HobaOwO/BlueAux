<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:b="clr-namespace:BlueAux;assembly=BlueAux"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <!-- Built from the design system in Styles.xaml: type ramp, 4 px spacing grid, cards and controls. -->
  <Grid.Resources>

    <!-- Rows in a card are split by a line, except above the first one. -->
    <Style x:Key="RowDivider" TargetType="Border" BasedOn="{StaticResource Divider}">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A page slides in a little as it fades in, like Windows 11 Settings. -->
    <Style x:Key="MainPage" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMainOpen}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static b:Motion.Normal}"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-12" To="0"
                                 Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingsPage" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static b:Motion.Normal}"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="12" To="0"
                                 Duration="{x:Static b:Motion.Normal}" EasingFunction="{StaticResource EaseOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Another phone on the main page (only shown when you have more than one) -->
    <DataTemplate x:Key="DeviceRow">
      <Grid>
        <Border Style="{StaticResource RowDivider}"/>
        <Grid MinHeight="48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Body}" Text="{Binding DisplayName}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding ShortStatus}"/>
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Button Style="{StaticResource Button}" Content="Connect" Command="{Binding ConnectCommand}"
                    Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource Button}" Content="Connecting…" IsEnabled="False"
                    Visibility="{Binding ShowConnecting, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource Button}" Content="Disconnect" Command="{Binding DisconnectCommand}"
                    Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StateName}" Value="Streaming">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A phone in Settings: connect automatically, or hide it -->
    <DataTemplate x:Key="DeviceSettingsRow">
      <Grid>
        <Border Style="{StaticResource RowDivider}"/>
        <Grid MinHeight="48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
          <StackPanel x:Name="Name" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Body}" Text="{Binding DisplayName}"/>
            <TextBlock Style="{StaticResource Caption}" Text="Hidden" Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource HyperlinkButton}" Content="Set up song display" Command="{Binding SetUpSongsCommand}"
                    HorizontalAlignment="Left" Margin="-8,0,0,0" Padding="8,2" FontSize="12"
                    ToolTip="This PC only has the audio pairing for this iPhone. Setting this up lets it show songs and use the volume-button fix."
                    Visibility="{Binding CanSetUpSongs, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding HideCommand}" Margin="0,0,8,0"
                  ToolTip="{Binding HideText}" AutomationProperties.Name="{Binding HideText}">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding HideGlyph}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
          </Button>
          <CheckBox x:Name="Auto" Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding AutoConnect}"
                    ToolTip="Connect by itself when it's nearby" AutomationProperties.Name="{Binding DisplayName}"/>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Auto" Property="IsEnabled" Value="False"/>
          <Setter TargetName="Name" Property="Opacity" Value="0.6"/>
          <Setter TargetName="Glyph" Property="Opacity" Value="0.6"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A theme to pick in Settings -->
    <DataTemplate x:Key="ThemeChoice">
      <Button Style="{StaticResource ThemeSwatch}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}"/>
    </DataTemplate>

  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="32"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- The title bar is ours (MainWindow's WindowChrome): no icon, no name, just the page's own buttons
       and the three caption buttons, drawn here so they take the theme's colours. -->
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" AutomationProperties.Name="Maximize"/>
    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close"/>
  </StackPanel>
  <Grid Visibility="{Binding IsMainOpen, Converter={StaticResource BoolToVis}}">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,142,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource IconButton}" Command="{Binding PairCommand}" ToolTip="Add a phone" AutomationProperties.Name="Add a phone">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14"/>
      </Button>
      <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14"/>
      </Button>
    </StackPanel>
  </Grid>
  <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource IconButton}" Command="{Binding CloseSettingsCommand}" ToolTip="Back" AutomationProperties.Name="Back">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="14"/>
      </Button>
      <TextBlock Style="{StaticResource BodyStrong}" Text="Settings" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>

  <!-- ===================== Main page ===================== -->
  <Grid Grid.Row="1" Style="{StaticResource MainPage}" Visibility="{Binding IsMainOpen, Converter={StaticResource BoolToVis}}">
    <Grid.RenderTransform>
      <TranslateTransform/>
    </Grid.RenderTransform>
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="16,8,16,16">

        <!-- Now playing: the song (or the phone), how it's doing, and what you can do about it -->
        <ContentControl Style="{StaticResource HeroCard}">
          <Grid>
            <!-- The song's own colours, as a soft tint over the whole card (the art shrunk to 4 x 4 pixels, drawn big) -->
            <Rectangle x:Name="Ambient" Margin="-16" RadiusX="11" RadiusY="11" Opacity="0" RenderOptions.BitmapScalingMode="Linear">
              <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding HeroAmbient}" Stretch="Fill"/>
              </Rectangle.Fill>
            </Rectangle>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- The circle: a soft accent halo behind it while it's lit, rings that pulse while waiting,
                   a dotted ring while there's nothing paired yet, and dancing bars while playing. With a song,
                   the cover takes its place and a record slides out from behind it and spins. HeroAnimator runs it. -->
              <Grid x:Name="HeroVisual" Width="64" Height="64">
                <Ellipse x:Name="Glow" Width="112" Height="112" Fill="{DynamicResource HeroGlow}" Opacity="0" Margin="-24"/>
                <Grid x:Name="CircleGroup" Width="64" Height="64" HorizontalAlignment="Left">
                <Ellipse x:Name="Ring1" Width="56" Height="56" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Ring2" Width="56" Height="56" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EmptyRing" Width="64" Height="64" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5" StrokeDashArray="3 3"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="HeroCircle" Width="56" Height="56" Fill="{DynamicResource HeroNeutral}"/>
                <Ellipse x:Name="AccentCircle" Width="56" Height="56" Fill="{DynamicResource Accent}" Opacity="0"/>
                <TextBlock x:Name="HeroGlyph" Style="{StaticResource Icon}" FontSize="22" Text="{Binding HeroGlyph}"/>
                <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                  <Rectangle x:Name="Bar0" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar1" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar2" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar3" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar4" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                  </Rectangle>
                </StackPanel>
                </Grid>

                <Grid x:Name="ArtGroup" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
                  <!-- The record: grooves, a sheen, the cover as its label, and the hole -->
                  <Grid x:Name="Disc" Width="56" Height="56" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                      <TransformGroup>
                        <RotateTransform/>
                        <TranslateTransform/>
                      </TransformGroup>
                    </Grid.RenderTransform>
                    <Ellipse>
                      <Ellipse.Fill>
                        <RadialGradientBrush>
                          <GradientStop Color="#FF303030" Offset="0.36"/>
                          <GradientStop Color="#FF151515" Offset="0.42"/>
                          <GradientStop Color="#FF2A2A2A" Offset="0.5"/>
                          <GradientStop Color="#FF121212" Offset="0.58"/>
                          <GradientStop Color="#FF262626" Offset="0.68"/>
                          <GradientStop Color="#FF101010" Offset="0.78"/>
                          <GradientStop Color="#FF222222" Offset="0.9"/>
                          <GradientStop Color="#FF0A0A0A" Offset="1"/>
                        </RadialGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Opacity="0.35">
                      <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#60FFFFFF" Offset="0"/>
                          <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                          <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                          <GradientStop Color="#30FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="22" Height="22" Fill="{DynamicResource Accent}"/>
                    <Ellipse Width="22" Height="22">
                      <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding HeroArt}" Stretch="UniformToFill"/>
                      </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="5" Height="5" Fill="#FF0A0A0A"/>
                  </Grid>
                  <!-- The cover: an accent tile with a note until the real one arrives -->
                  <Grid x:Name="Art" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                      <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Border CornerRadius="8" Background="{DynamicResource Accent}">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="22" Foreground="{DynamicResource OnAccent}"/>
                    </Border>
                    <Border CornerRadius="8">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding HeroArt}" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource HeroStroke}"/>
                  </Grid>
                </Grid>
              </Grid>

              <StackPanel x:Name="HeroText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                  <TranslateTransform/>
                </StackPanel.RenderTransform>
                <TextBlock Style="{StaticResource HeroTitle}" Text="{Binding HeroTitle}" ToolTip="{Binding HeroTitle}"/>
                <TextBlock Style="{StaticResource BodySecondary}" Text="{Binding HeroSubtitle}" ToolTip="{Binding HeroSubtitle}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding HeroDevice}" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>

            <!-- Fix sound and the obvious next thing, side by side -->
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource Button}" Command="{Binding FixAudioCommand}" Margin="0,0,8,0"
                      Visibility="{Binding ShowFixAudio, Converter={StaticResource BoolToVis}}"
                      ToolTip="No sound? Press play on your phone, then click this to reconnect. With an iPhone, pressing a volume button does the same.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="14" Margin="0,0,8,0"/>
                  <TextBlock Text="Fix sound"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource AccentButton}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}" MinWidth="96"
                      Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}"/>
              <Button Style="{StaticResource Button}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}" MinWidth="96"
                      Visibility="{Binding ShowSecondaryAction, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
          </StackPanel>
          </Grid>
        </ContentControl>

        <!-- The PC itself is muted: the most common "no sound" of all -->
        <Border Style="{StaticResource InfoBar}" Margin="0,8,0,0" Visibility="{Binding ShowPcSilenced, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Caution}"/>
            <TextBlock Style="{StaticResource Body}" Text="This PC's sound is muted"/>
          </StackPanel>
        </Border>

        <!-- An iPhone this PC only has the audio pairing for: one tap to let it show songs (PhoneSetup) -->
        <ContentControl Style="{StaticResource AppearingCard}" Margin="0,8,0,0" Padding="16,8,8,8"
                        Visibility="{Binding ShowSongSetup, Converter={StaticResource BoolToVis}}">
          <Grid MinHeight="32">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding SongSetupText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Lets BlueAux show the song, and fix silent apps like TikTok when you press a volume button. Your iPhone asks to pair once."/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource AccentButton}" Content="{Binding SongSetupAction}" Command="{Binding SongSetupCommand}"
                      Visibility="{Binding ShowSongSetupAction, Converter={StaticResource BoolToVis}}"/>
              <Button Style="{StaticResource IconButton}" Command="{Binding SongSetupDismissCommand}" Margin="4,0,0,0"
                      ToolTip="Not now (it stays in Settings)" AutomationProperties.Name="Not now"
                      Visibility="{Binding ShowSongSetupDismiss, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
              </Button>
            </StackPanel>
          </Grid>
        </ContentControl>

        <!-- First run: offer to start with Windows -->
        <ContentControl Style="{StaticResource AppearingCard}" Margin="0,8,0,0" Padding="16,8"
                        Visibility="{Binding ShowStartupPrompt, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Body}" Text="Start with Windows?" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Then it waits in the tray and your phone connects whenever it's nearby, like in a car."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource AccentButton}" Content="Yes" MinWidth="56" Command="{Binding EnableStartupCommand}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource SubtleButton}" Content="Not now" Command="{Binding DismissStartupCommand}"/>
            </StackPanel>
          </Grid>
        </ContentControl>

        <!-- Several phones: pick which one plays -->
        <ContentControl Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,0"
                        Visibility="{Binding ShowDeviceList, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRow}" AlternationCount="1000" Focusable="False"/>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- ===================== Settings page ===================== -->
  <Grid Grid.Row="1" Style="{StaticResource SettingsPage}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
    <Grid.RenderTransform>
      <TranslateTransform/>
    </Grid.RenderTransform>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="16,8,16,16">

        <!-- General -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="General" Margin="4,4,0,8"/>
        <ContentControl Style="{StaticResource Card}" Padding="16,0">
          <StackPanel>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE7E8;" Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                      ToolTip="Waits in the tray so your phone can connect any time"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xEA8F;" Content="Notifications" IsChecked="{Binding Notifications}"
                      ToolTip="Tell me when a phone connects or disconnects"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE7C4;" Content="Keep running when closed" IsChecked="{Binding CloseToTray}"
                      ToolTip="Closing the window hides it to the tray instead of quitting"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE718;" Content="Always on top" IsChecked="{Binding AlwaysOnTop}"
                      ToolTip="Keeps this window above other windows"/>
          </StackPanel>
        </ContentControl>

        <!-- When you're away: resting, and what happens to the phone -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="When you're away"/>
        <ContentControl Style="{StaticResource Card}" Padding="16,0">
          <StackPanel>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE708;" Content="Rest when I'm away" IsChecked="{Binding RestWhenIdle}"
                      ToolTip="With no mouse or keyboard use (or the PC locked), stop looking for your phone. Music that's playing keeps going."/>
            <StackPanel Margin="30,0,0,8" Visibility="{Binding RestWhenIdle, Converter={StaticResource BoolToVis}}">
              <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource BodySecondary}" Text="After" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconButton}" Command="{Binding IdleLessCommand}" ToolTip="Less" AutomationProperties.Name="Fewer minutes">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12"/>
                  </Button>
                  <TextBox x:Name="IdleBox" Style="{StaticResource NumberBox}" Text="{Binding IdleMinutesText}" Width="48" MaxLength="3"
                           TextAlignment="Center" Margin="4,0" AutomationProperties.Name="Idle minutes"/>
                  <Button Style="{StaticResource IconButton}" Command="{Binding IdleMoreCommand}" ToolTip="More" AutomationProperties.Name="More minutes">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                  </Button>
                  <TextBlock Style="{StaticResource BodySecondary}" Text="min" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
              </Grid>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisconnectWhenIdle}" MinHeight="40"
                        ToolTip="Off is more reliable: some iPhones come back without sound after being disconnected while paused.">
                <TextBlock Style="{StaticResource BodySecondary}" Text="Disconnect the phone too"/>
              </CheckBox>
            </StackPanel>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE7F4;" Content="Disconnect when PC sleeps" IsChecked="{Binding DisconnectWhenAsleep}"
                      ToolTip="So nothing plays on a PC nobody is at; it reconnects when you're back"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE72E;" Content="Disconnect when PC is locked" IsChecked="{Binding DisconnectWhenLocked}"
                      ToolTip="So nothing plays on a PC nobody is at; it reconnects when you're back"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE82F;" Content="Keep PC awake while playing" IsChecked="{Binding KeepAwake}"
                      ToolTip="Stops the PC from going to sleep in the middle of a song"/>
          </StackPanel>
        </ContentControl>

        <!-- Appearance: the theme, whether things move, album art, and how the tray icon looks -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance"/>
        <ContentControl Style="{StaticResource Card}" Padding="16,0">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Themes}" ItemTemplate="{StaticResource ThemeChoice}" Focusable="False" Margin="-4,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE768;" Content="Animations" IsChecked="{Binding Animations}"
                      ToolTip="Buttons, pages and the now-playing circle move. Turn it off on a slow PC, or in Windows' accessibility settings."/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE91B;" Content="Album art" IsChecked="{Binding AlbumArt}"
                      ToolTip="Shows the cover of the song your iPhone is playing. The song's title and artist are looked up in Apple's iTunes catalogue (and Deezer's); nothing else is sent."/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Tag="&#xE9A6;" Content="Plain tray icon" IsChecked="{Binding MonoTrayIcon}"
                      ToolTip="A white or black mark in the tray, like Windows' own icons, instead of the coloured tile"/>
          </StackPanel>
        </ContentControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Connect automatically"/>
        <ContentControl Style="{StaticResource Card}" Padding="16,0">
          <ItemsControl ItemsSource="{Binding AllDevices}" ItemTemplate="{StaticResource DeviceSettingsRow}" AlternationCount="1000" Focusable="False"/>
        </ContentControl>

        <!-- More: shortcuts to Windows, a restart, and the activity log -->
        <Button Style="{StaticResource SubtleButton}" Command="{Binding ToggleMoreCommand}" HorizontalAlignment="Left" Margin="-4,16,0,0" Padding="8,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource BodyStrong}" Text="More"/>
            <TextBlock FontSize="10" Margin="8,2,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                  <Setter Property="Text" Value="&#xE70D;"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMoreOpen}" Value="True">
                      <Setter Property="Text" Value="&#xE70E;"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>

        <StackPanel Visibility="{Binding IsMoreOpen, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
          <UniformGrid Rows="1" Margin="0,0,-8,0">
            <Button Style="{StaticResource Button}" Content="Bluetooth" Command="{Binding PairCommand}" Margin="0,0,8,0"
                    ToolTip="Windows Bluetooth settings"/>
            <Button Style="{StaticResource Button}" Content="Sound" Command="{Binding SoundSettingsCommand}" Margin="0,0,8,0"
                    ToolTip="Windows sound settings: pick the speakers it plays on"/>
            <Button Style="{StaticResource Button}" Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,8,0"
                    ToolTip="Drops and rebuilds every connection. Use it if something seems stuck."/>
          </UniformGrid>

          <Grid Margin="0,12,0,8">
            <TextBlock Style="{StaticResource BodyStrong}" Text="Activity" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Content="Open logs" Command="{Binding OpenLogCommand}"/>
          </Grid>
          <ContentControl Style="{StaticResource AppearingCard}" Padding="12,8">
            <ItemsControl ItemsSource="{Binding LogEntries}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiary}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ContentControl>
        </StackPanel>

        <!-- About -->
        <WrapPanel Margin="4,16,0,0">
          <TextBlock Style="{StaticResource Caption}" Text="{Binding AboutText}" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button Style="{StaticResource HyperlinkButton}" Content="GitHub" Command="{Binding OpenRepoCommand}" FontSize="12"/>
          <Button Style="{StaticResource HyperlinkButton}" Content="Report a problem" Command="{Binding ReportProblemCommand}" FontSize="12"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Grid>
