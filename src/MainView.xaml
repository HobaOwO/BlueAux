<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Built from the design system in Styles.xaml: type ramp, 4 px spacing grid, cards and controls. -->
  <Grid.Resources>

    <!-- Rows in a card are split by a line, except above the first one. -->
    <Style x:Key="RowDivider" TargetType="Border" BasedOn="{StaticResource Divider}">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Another phone on the main page (only shown when you have more than one) -->
    <DataTemplate x:Key="DeviceRow">
      <Grid>
        <Border Style="{StaticResource RowDivider}"/>
        <Grid MinHeight="48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Body}" Text="{Binding DisplayName}"/>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding ShortStatus}"/>
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Button Style="{StaticResource Button}" Content="Connect" Command="{Binding ConnectCommand}"
                    Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource Button}" Content="Connecting…" IsEnabled="False"
                    Visibility="{Binding ShowConnecting, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource Button}" Content="Disconnect" Command="{Binding DisconnectCommand}"
                    Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding StateName}" Value="Streaming">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A phone in Settings: connect automatically, or hide it -->
    <DataTemplate x:Key="DeviceSettingsRow">
      <Grid>
        <Border Style="{StaticResource RowDivider}"/>
        <Grid MinHeight="48">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
          <StackPanel x:Name="Name" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Body}" Text="{Binding DisplayName}"/>
            <TextBlock Style="{StaticResource Caption}" Text="Hidden" Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding HideCommand}" Margin="0,0,8,0"
                  ToolTip="{Binding HideText}" AutomationProperties.Name="{Binding HideText}">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding HideGlyph}" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
          </Button>
          <CheckBox x:Name="Auto" Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding AutoConnect}"
                    ToolTip="Connect by itself when it's nearby" AutomationProperties.Name="{Binding DisplayName}"/>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Auto" Property="IsEnabled" Value="False"/>
          <Setter TargetName="Name" Property="Opacity" Value="0.6"/>
          <Setter TargetName="Glyph" Property="Opacity" Value="0.6"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Grid.Resources>

  <!-- ===================== Main page ===================== -->
  <Grid Visibility="{Binding IsMainOpen, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="16,4,16,16">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-4,8">
          <Button Style="{StaticResource IconButton}" Command="{Binding PairCommand}" ToolTip="Add a phone" AutomationProperties.Name="Add a phone">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="14"/>
          </Button>
        </StackPanel>

        <!-- Now playing: the song (or the phone), how it's doing, and what you can do about it -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid Width="64" Height="64">
                <Ellipse x:Name="Ring1" Width="56" Height="56" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Ring2" Width="56" Height="56" Fill="{DynamicResource AccentSoft}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="HeroCircle" Width="56" Height="56" Fill="{DynamicResource Accent}"/>
                <TextBlock x:Name="HeroGlyph" Style="{StaticResource Icon}" FontSize="22" Text="{Binding HeroGlyph}"/>
                <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                  <Rectangle x:Name="Bar0" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar1" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar2" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar3" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <Rectangle x:Name="Bar4" Width="4" Height="22" RadiusX="2" RadiusY="2" Margin="1.5,0" Fill="{DynamicResource OnAccent}" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                  </Rectangle>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding HeroTitle}" ToolTip="{Binding HeroTitle}"/>
                <TextBlock Style="{StaticResource BodySecondary}" Text="{Binding HeroSubtitle}" ToolTip="{Binding HeroSubtitle}"/>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding HeroDevice}" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>

            <!-- Fix sound and the obvious next thing, side by side -->
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource Button}" Command="{Binding FixAudioCommand}" Margin="0,0,8,0"
                      Visibility="{Binding ShowFixAudio, Converter={StaticResource BoolToVis}}"
                      ToolTip="No sound? Press play on your phone, then click this to reconnect. With an iPhone, pressing a volume button does the same.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="14" Margin="0,0,8,0"/>
                  <TextBlock Text="Fix sound"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource AccentButton}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}" MinWidth="96"
                      Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}"/>
              <Button Style="{StaticResource Button}" Content="{Binding HeroActionText}" Command="{Binding HeroActionCommand}" MinWidth="96"
                      Visibility="{Binding ShowSecondaryAction, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- The PC itself is muted: the most common "no sound" of all -->
        <Border Style="{StaticResource InfoBar}" Margin="0,8,0,0" Visibility="{Binding ShowPcSilenced, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Caution}"/>
            <TextBlock Style="{StaticResource Body}" Text="This PC's sound is muted"/>
          </StackPanel>
        </Border>

        <!-- First run: offer to start with Windows -->
        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,8"
                Visibility="{Binding ShowStartupPrompt, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Body}" Text="Start with Windows?" VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Then it waits in the tray and your phone connects whenever it's nearby, like in a car."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource AccentButton}" Content="Yes" MinWidth="56" Command="{Binding EnableStartupCommand}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource SubtleButton}" Content="Not now" Command="{Binding DismissStartupCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Several phones: pick which one plays -->
        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,0"
                Visibility="{Binding ShowDeviceList, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRow}" AlternationCount="1000" Focusable="False"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- ===================== Settings page ===================== -->
  <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="16,4,16,16">

        <StackPanel Orientation="Horizontal" Margin="-4,0,0,8">
          <Button Style="{StaticResource IconButton}" Command="{Binding CloseSettingsCommand}" ToolTip="Back" AutomationProperties.Name="Back">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="14"/>
          </Button>
          <TextBlock Style="{StaticResource Subtitle}" Text="Settings" VerticalAlignment="Center" Margin="8,0,0,2"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="16,0">
          <StackPanel>
            <CheckBox Style="{StaticResource SettingSwitch}" Content="Start with Windows" IsChecked="{Binding StartWithWindows}"
                      ToolTip="Waits in the tray so your phone can connect any time"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Content="Notifications" IsChecked="{Binding Notifications}"
                      ToolTip="Tell me when a phone connects or disconnects"/>
            <Border Style="{StaticResource Divider}"/>
            <CheckBox Style="{StaticResource SettingSwitch}" Content="Rest when I'm away" IsChecked="{Binding RestWhenIdle}"
                      ToolTip="With no mouse or keyboard use (or the PC locked), stop looking for your phone. Music that's playing keeps going."/>
            <StackPanel Margin="0,0,0,8" Visibility="{Binding RestWhenIdle, Converter={StaticResource BoolToVis}}">
              <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource BodySecondary}" Text="After (minutes)" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconButton}" Command="{Binding IdleLessCommand}" ToolTip="Less" AutomationProperties.Name="Fewer minutes">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12"/>
                  </Button>
                  <TextBox x:Name="IdleBox" Style="{StaticResource NumberBox}" Text="{Binding IdleMinutesText}" Width="48" MaxLength="3"
                           TextAlignment="Center" Margin="4,0" AutomationProperties.Name="Idle minutes"/>
                  <Button Style="{StaticResource IconButton}" Command="{Binding IdleMoreCommand}" ToolTip="More" AutomationProperties.Name="More minutes">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                  </Button>
                </StackPanel>
              </Grid>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisconnectWhenIdle}" MinHeight="40"
                        ToolTip="Off is more reliable: some iPhones come back without sound after being disconnected while paused.">
                <TextBlock Style="{StaticResource BodySecondary}" Text="Disconnect the phone too"/>
              </CheckBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Connect automatically"/>
        <Border Style="{StaticResource Card}" Padding="16,0">
          <ItemsControl ItemsSource="{Binding AllDevices}" ItemTemplate="{StaticResource DeviceSettingsRow}" AlternationCount="1000" Focusable="False"/>
        </Border>

        <Button Style="{StaticResource SubtleButton}" Command="{Binding ToggleMoreCommand}" HorizontalAlignment="Left" Margin="-4,16,0,0" Padding="8,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource BodyStrong}" Text="More"/>
            <TextBlock FontSize="10" Margin="8,2,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                  <Setter Property="Text" Value="&#xE70D;"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMoreOpen}" Value="True">
                      <Setter Property="Text" Value="&#xE70E;"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>

        <StackPanel Visibility="{Binding IsMoreOpen, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
          <Border Style="{StaticResource Card}" Padding="16,0">
            <StackPanel>
              <CheckBox Style="{StaticResource SettingSwitch}" Content="Keep running when closed" IsChecked="{Binding CloseToTray}"
                        ToolTip="Closing the window hides it to the tray instead of quitting"/>
              <Border Style="{StaticResource Divider}"/>
              <CheckBox Style="{StaticResource SettingSwitch}" Content="Keep the PC awake while playing" IsChecked="{Binding KeepAwake}"
                        ToolTip="Stops the PC from going to sleep in the middle of a song"/>
            </StackPanel>
          </Border>

          <UniformGrid Rows="1" Margin="0,8,-8,0">
            <Button Style="{StaticResource Button}" Content="Bluetooth" Command="{Binding PairCommand}" Margin="0,0,8,0"
                    ToolTip="Windows Bluetooth settings"/>
            <Button Style="{StaticResource Button}" Content="Sound" Command="{Binding SoundSettingsCommand}" Margin="0,0,8,0"
                    ToolTip="Windows sound settings: pick the speakers it plays on"/>
            <Button Style="{StaticResource Button}" Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,8,0"
                    ToolTip="Drops and rebuilds every connection. Use it if something seems stuck."/>
          </UniformGrid>

          <Grid Margin="0,12,0,8">
            <TextBlock Style="{StaticResource BodyStrong}" Text="Activity" Margin="4,0,0,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource HyperlinkButton}" HorizontalAlignment="Right" Margin="0,0,-8,0" Content="Open logs" Command="{Binding OpenLogCommand}"/>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="12,8">
            <ItemsControl ItemsSource="{Binding LogEntries}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- About -->
        <WrapPanel Margin="4,16,0,0">
          <TextBlock Style="{StaticResource Caption}" Text="{Binding AboutText}" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button Style="{StaticResource HyperlinkButton}" Content="GitHub" Command="{Binding OpenRepoCommand}" FontSize="12"/>
          <Button Style="{StaticResource HyperlinkButton}" Content="Report a problem" Command="{Binding ReportProblemCommand}" FontSize="12"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Grid>
